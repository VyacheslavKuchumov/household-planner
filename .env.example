# Production/public deployment
APP_DOMAIN=planner.example.com
ACME_EMAIL=admin@example.com
POSTGRES_DB=household_planner
POSTGRES_USER=household
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local development database (compose.dev.yaml)
DEV_DB_NAME=household_planner_dev
DEV_DB_USER=household_dev
DEV_DB_PASSWORD=household_dev_local_only
DEV_DB_PORT=5433

# API identity and password-reset delivery
# Generate RSA keys: ./scripts/generate-jwt-keys.sh
# APP_PUBLIC_URL=https://planner.example.com
# ALLOWED_ORIGINS=https://planner.example.com
COOKIE_SAME_SITE=Lax
JWT_KEY_ID=primary
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_STARTTLS=true
MAIL_FROM=Household Planner <noreply@example.com>
